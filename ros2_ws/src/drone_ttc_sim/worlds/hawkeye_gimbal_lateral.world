<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="default">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.025 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>12 12 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>12 12 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <physics name="physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.70 0.78 0.85 1</background>
      <shadows>false</shadows>
    </scene>
    <include>
      <name>target_person</name>
      <pose>4.0 0.0 0.0 0 0 -1.5708</pose>
      <static>true</static>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person
      </uri>
    </include>
    <include>
      <pose>1.0 0.0 1.2 0 0 0</pose>
      <uri>model://x3_hawkeye</uri>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions>
      </plugin>
      <plugin filename="libHawkeyeCarrierMotion.so" name="hawkeye::CarrierMotion">
        <mode>lateral</mode>
        <x0>1.0</x0>
        <y0>0.0</y0>
        <z0>1.2</z0>
        <amplitude>0.35</amplitude>
        <omega>0.5</omega>
        <hold_seconds>3.0</hold_seconds>
        <yaw_amplitude_deg>5.0</yaw_amplitude_deg>
        <pitch_amplitude_deg>4.0</pitch_amplitude_deg>
        <triggered>true</triggered>
      </plugin>
    </include>
  </world>
</sdf>