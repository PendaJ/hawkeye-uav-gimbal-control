      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>5</effort>
          <velocity>1.5</velocity>
        </limit>
      </axis>
    </joint>
    <joint name="gimbal_pitch_joint" type="revolute">
      <pose>-0.05 0 0 0 0 0</pose>
      <parent>gimbal_yaw_link</parent>
      <child>gimbal_pitch_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.3963</lower>
          <upper>1.3963</upper>
          <effort>5</effort>
          <velocity>1.5</velocity>
        </limit>
      </axis>
    </joint>
